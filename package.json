{
  "name": "react-native-duo-layout",
  "version": "0.1.0",
  "description": "Fold-aware layout hooks and a tappable status-strip toolbar for the iPhone Duo (and other foldables) in React Native.",
  "source": "./src/index.ts",
  "react-native": "./src/index.ts",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/*.test.*"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "prepare": "bob build"
  },
  "keywords": [
    "react-native",
    "foldable",
    "iphone-duo",
    "safe-area",
    "status-bar",
    "layout",
    "hooks"
  ],
  "license": "MIT",
  "author": "ehsanexe <ehsanexe01@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ehsanexe/react-native-duo-layout.git"
  },
  "homepage": "https://github.com/ehsanexe/react-native-duo-layout#readme",
  "bugs": {
    "url": "https://github.com/ehsanexe/react-native-duo-layout/issues"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-safe-area-context": ">=4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/jest-preset": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.40.13",
    "react-native-safe-area-context": "^5.8.0",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      ["module", { "esm": true }],
      ["typescript", { "project": "tsconfig.build.json" }]
    ]
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
